<div class="news">
  {% assign news = site.data.news | sort: 'date' | reverse %}
  {% if news != blank %}
    {% assign news_size = news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {{ item.content | emojify }}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit and news_size > news_limit %}
      {% assign expanded_news_limit = 10 | minus: news_limit %}
      {% if expanded_news_limit > 0 %}
        <details class="news-more">
          <summary>More news</summary>
          <div class="table-responsive">
            <table class="table table-sm table-borderless">
              {% for item in news offset: news_limit limit: expanded_news_limit %}
                <tr>
                  <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                  <td>
                    {{ item.content | emojify }}
                  </td>
                </tr>
              {% endfor %}
            </table>
          </div>
        </details>
      {% endif %}
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
